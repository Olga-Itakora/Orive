# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://oriva:oriva@localhost:5432/oriva?schema=public"

# --- URL pública de la aplicación (se usa en QR, PDF y enlaces de verificación) ---
# En producción: https://orivacode.com
APP_URL="http://localhost:3000"

# --- Secreto de la aplicación (mín. 32 caracteres aleatorios) ---
# Se usa para derivar huellas de IP en auditoría y límites de frecuencia.
# Genera uno con: openssl rand -base64 48
APP_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# --- Almacenamiento de evidencias (fuera del directorio público) ---
EVIDENCE_STORAGE_DIR="./storage/evidence"
EVIDENCE_MAX_BYTES="10485760"

# --- Administrador inicial creado por el seed (cambiar la contraseña tras el primer acceso) ---
SEED_ADMIN_EMAIL="admin@orivacode.com"
SEED_ADMIN_PASSWORD="change-me-admin-password"

# --- Correo (no implementado en el MVP: los enlaces de recuperación se escriben en el log del servidor) ---
# SMTP_URL="smtp://user:pass@smtp.example.eu:587"
# MAIL_FROM="ORIVA <no-reply@orivacode.com>"

# --- Cookies seguras: "true" en producción tras HTTPS ---
COOKIE_SECURE="false"
